# /etc/dendrite/dendrited.env
#
# Deployment-specific overrides for dendrited.service. Values here are
# loaded via EnvironmentFile and take precedence over the Environment=
# lines baked into the unit file. See docs/CONFIGURATION.md for the full
# variable reference. This file is installed as-is by the .deb package
# (packaging/dendrited.env.example is its single source of truth) and is a
# conffile: your edits survive package upgrades.

# Colon-separated list of mount points fanotify should mark at startup.
# Leave unset/empty (the default) to watch every real, non-pseudo mount
# discovered from /proc/self/mountinfo — there is no need to set this for
# a working install; it only narrows what gets watched, it never expands
# it beyond what's actually mounted.
#DENDRITE_WATCH_MOUNTS=

# Colon-separated list of additional paths (outside the discovered mounts
# above) to include.
#DENDRITE_WATCH_INCLUDE_PATHS=

# Colon-separated list of paths to exclude from watching.
#DENDRITE_WATCH_EXCLUDE_PATHS=

# Uncomment to override the telemetry fallback poll interval (seconds).
#DENDRITE_TELEMETRY_INTERVAL_SECONDS=2

# Herd (see crates/dendrited/src/herd.rs and packaging/herd.json.example):
# how often this host pushes a fresh Antiserum export to every peer listed
# in DENDRITE_HERD_CONFIG (default /etc/dendrite/herd.json). A missing or
# empty herd.json means Herd is disabled — there is nothing to configure
# here for a normal single-node install.
#DENDRITE_HERD_PUSH_INTERVAL_SECONDS=120
