[Unit]
Description=Dendrite trust/integrity/recovery boundary (Guard)
Documentation=https://github.com/anthrosystems/dendrite
After=network.target local-fs.target
Before=dendrited.service
# dendrited is a client of this process's socket, not the other way round —
# see packaging/dendrite-magi.service for the same reasoning. dendrited's
# own MagiIpcClient-style client (GuardIpcClient) fails closed (denies
# authority, reports trust state as compromised) whenever this unit isn't
# up, so there is no hard `Requires=` in either direction: an operator can
# stop/restart this unit independently, and dendrited keeps running (just
# unable to authorise anything privileged) rather than going down with it.
# `Before=` only orders startup so a fresh boot doesn't race dendrited's
# first authority check against this socket appearing.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/dendrite-guard
Restart=on-failure
RestartSec=2

# --- Identity ---
# Its OWN dedicated account, distinct from dendrited's/dendrite-magi's
# `dendrite` user (both created by the package's postinst) — not shared.
# "Compromise can remove authority, but cannot create authority" only holds
# if a compromised dendrited can't reach Guard's *on-disk* state either:
# until this change, dendrite-guard ran as the same `dendrite` user as
# dendrited and shared its /var/lib/dendrite state directory, so a
# compromised dendrited (same user, same writable directory) could edit
# guard.sqlite3 directly — bypassing the socket, the process boundary, and
# every fail-closed check in dendrite_guard's own code entirely. See
# crates/dendrite-guard/README.md's "Privilege separation" section.
#
# Group=dendrite (not dendrite-guard's own group) is deliberate: it's the
# group systemd applies to files/directories this unit's State/Runtime
# directives create (below), and it's what lets dendrited (a member of
# `dendrite`) reach this process's *socket* — the one thing it's still
# meant to reach. StateDirectoryMode=0700 below means that same group gets
# no access at all to guard.sqlite3's directory, even though the group is
# nominally shared.
User=dendrite-guard
Group=dendrite
NoNewPrivileges=yes

# --- Filesystem layout ---
# Both directories are now uniquely named to this unit — dendrited.service
# and dendrite-magi.service don't reference either one — so the shared-
# RuntimeDirectory= teardown bug that ruled out RuntimeDirectory= for
# /run/dendrite (https://github.com/systemd/systemd/issues/5394, see
# packaging/dendrite.tmpfiles) doesn't apply here: nothing else stopping
# would tear these down, and nothing else stops when *this* unit restarts.
#
# StateDirectoryMode=0700 is the actual privilege-separation boundary:
# owned by dendrite-guard, mode rwx------, so group `dendrite` (i.e.
# dendrited) gets no access whatsoever to guard.sqlite3 or anything else
# placed here — not even read. RuntimeDirectoryMode=0750 is deliberately
# looser (owner rwx, group r-x) so dendrited can still traverse into
# /run/dendrite-guard and reach the socket file itself; the socket file's
# own permissions (DENDRITE_GUARD_SOCKET_GROUP/_MODE below) are what
# actually grant dendrited connect access to it.
StateDirectory=dendrite-guard
StateDirectoryMode=0700
RuntimeDirectory=dendrite-guard
RuntimeDirectoryMode=0750

Environment=DENDRITE_GUARD_DB=/var/lib/dendrite-guard/guard.sqlite3
Environment=DENDRITE_GUARD_SOCKET=/run/dendrite-guard/dendrite-guard.sock
# The socket itself needs its own explicit group/mode (dendrite-guard's own
# code chowns/chmods it after bind — see crates/dendrite-guard/src/main.rs)
# since it's created by the dendrite-guard user but dendrited (a different
# user, member of the dendrite group) must still be able to connect to it.
Environment=DENDRITE_GUARD_SOCKET_GROUP=dendrite
Environment=DENDRITE_GUARD_SOCKET_MODE=0660
# The integrity manifest's watch set: the binaries cargo-deb installs, the
# eBPF object, and the four units themselves (see
# crates/dendrited/Cargo.toml's [package.metadata.deb] `assets`/
# `systemd-units` for where each of these actually lands) — see
# crates/dendrite-guard/README.md's "Integrity manifest" section for what
# `dendrite guard baseline`/`guard verify` do with this. Setting this alone
# still doesn't establish a baseline by itself — an operator (or install
# tooling) must still run `dendrite guard baseline` once — but once a
# baseline exists, this process verifies these same paths against it
# automatically in the background (see DENDRITE_GUARD_VERIFY_INTERVAL_SECONDS
# below), not only when `dendrite guard verify` is run by hand.
Environment=DENDRITE_GUARD_WATCH_PATHS=/usr/bin/dendrited:/usr/bin/dendrite-cli:/usr/bin/dendrite-ui-server:/usr/bin/dendrite-magi:/usr/bin/dendrite-guard:/usr/lib/dendrite/dendrite-ebpf:/lib/systemd/system/dendrited.service:/lib/systemd/system/dendrite-ui.service:/lib/systemd/system/dendrite-magi.service:/lib/systemd/system/dendrite-guard.service
# How often the background verification pass re-checks the watch set above
# against the stored baseline (see crates/dendrite-guard/README.md's
# "Integrity manifest" section). Explicit here even though it matches the
# built-in default (300s), so the packaged interval is a deliberate, visible
# choice rather than an implicit one.
Environment=DENDRITE_GUARD_VERIFY_INTERVAL_SECONDS=300

# --- Sandboxing / hardening ---
# No telemetry, no eBPF, no network beyond its own socket — lock this down
# harder than dendrited can be today. No explicit ReadWritePaths= needed:
# StateDirectory=/RuntimeDirectory= above already grant write access to
# their own directories, and (unlike the old shared /var/lib/dendrite)
# there is deliberately nothing else this unit needs write access to.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
