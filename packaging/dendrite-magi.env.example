# /etc/dendrite/dendrite-magi.env
#
# Deployment-specific overrides for dendrite-magi.service, loaded via
# EnvironmentFile. See docs/CONFIGURATION.md for the full variable
# reference. This file is installed as-is by the .deb package
# (packaging/dendrite-magi.env.example is its single source of truth) and is
# a conffile: your edits survive package upgrades.

# Each MAGI seat defaults to "internal" (the built-in rule-based evaluator)
# when unset. Set a seat to "mcp" to fully replace its vote with an external
# MCP-connected agent instead — see crates/dendrite-magi/README.md for the
# full picture (fail-closed to abstain on any spawn/handshake/tool-call
# failure). Setting a _SOURCE to anything other than "internal"/"mcp" makes
# dendrite-magi refuse to start, on purpose, rather than silently falling
# back to the internal evaluator for that seat.
#DENDRITE_MAGI_HOST_SOURCE=internal
#DENDRITE_MAGI_USER_SOURCE=internal
#DENDRITE_MAGI_ENVIRONMENT_SOURCE=internal

# Required when a seat above is set to "mcp": the command to spawn as that
# seat's MCP server (talked to over stdio), optional whitespace-split
# arguments, and the MCP tool name to call (defaults to "evaluate_action"
# if left unset). Uncomment and adjust per seat as needed, e.g.:
#DENDRITE_MAGI_HOST_MCP_COMMAND=/usr/local/bin/my-host-evaluator
#DENDRITE_MAGI_HOST_MCP_ARGS=--stdio
#DENDRITE_MAGI_HOST_MCP_TOOL=evaluate_action
