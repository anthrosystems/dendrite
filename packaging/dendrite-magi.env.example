# /etc/dendrite/dendrite-magi.env
#
# Deployment-specific overrides for dendrite-magi.service, loaded via
# EnvironmentFile. See docs/CONFIGURATION.md for the full variable
# reference. This file is installed as-is by the .deb package
# (packaging/dendrite-magi.env.example is its single source of truth) and is
# a conffile: your edits survive package upgrades.

# Each MAGI seat defaults to "internal" (the built-in rule-based evaluator)
# when unset — that is the only value implemented today. These exist so
# that hooking up an MCP-connected evaluator for a seat, once that support
# exists, is a configuration change here rather than a code change. Setting
# any of these to anything other than "internal" right now makes
# dendrite-magi refuse to start, on purpose, rather than silently falling
# back to the internal evaluator for that seat.
#DENDRITE_MAGI_HOST_SOURCE=internal
#DENDRITE_MAGI_USER_SOURCE=internal
#DENDRITE_MAGI_ENVIRONMENT_SOURCE=internal
