# /etc/dendrite/dendrite-ui.env
#
# Deployment-specific overrides for dendrite-ui.service, loaded via
# EnvironmentFile. See docs/CONFIGURATION.md for the full variable
# reference. This file is installed as-is by the .deb package
# (packaging/dendrite-ui.env.example is its single source of truth) and is a
# conffile: your edits survive package upgrades.

# Where dendrited's HTTP/WebSocket API lives, from the browser's point of
# view. The out-of-the-box package is two independent processes on two
# fixed ports on the same host — dendrited on 127.0.0.1:8766
# (packaging/dendrited.service), dendrite-ui-server on 127.0.0.1:8767
# (packaging/dendrite-ui.service) — not one origin behind a reverse proxy,
# so this is set below by default rather than left commented out: an
# unset value tells the UI to use *same-origin* relative paths, which on
# the stock install means every API/WebSocket request actually lands on
# dendrite-ui-server itself (a static-file server with no API routes,
# see crates/dendrite-ui-server/src/main.rs) and gets its SPA-fallback
# index.html back instead of JSON — the browser then fails to parse it.
# Change this only if you've put a reverse proxy in front of both (then
# leave it unset/commented for true same-origin) or moved dendrited to a
# different host/port:
DENDRITE_UI_API_ORIGIN=http://127.0.0.1:8766
