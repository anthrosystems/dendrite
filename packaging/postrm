#!/bin/sh
# postrm for the dendrited .deb package.
#
# Ordinary removal (`apt remove dendrite`) leaves all state alone —
# /var/lib/dendrite (the Memory Graph, incidents, self identity/signing
# keys), /var/lib/dendrite-guard (Guard's own trust state, integrity
# manifest and recovery token — deliberately in its own
# StateDirectory=, unreadable by the `dendrite` account; see
# crates/dendrite-guard/README.md's "Privilege separation" section) and
# /etc/dendrite/dendrited.env (a conffile dpkg already handles on its
# own) survive so a reinstall picks up where it left off. Only `apt
# purge` removes runtime state and the dedicated system accounts,
# matching Debian policy for a package's own generated data.
set -e

case "$1" in
    purge)
        rm -rf /var/lib/dendrite
        rm -rf /var/lib/dendrite-guard
        rmdir --ignore-fail-on-non-empty /etc/dendrite 2>/dev/null || true
        if getent passwd dendrite >/dev/null; then
            deluser --system dendrite >/dev/null 2>&1 || true
        fi
        if getent group dendrite >/dev/null; then
            delgroup --system dendrite >/dev/null 2>&1 || true
        fi
        if getent passwd dendrite-guard >/dev/null; then
            deluser --system dendrite-guard >/dev/null 2>&1 || true
        fi
        if getent group dendrite-guard >/dev/null; then
            delgroup --system dendrite-guard >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
