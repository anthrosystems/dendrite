{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antiserum Graph Fragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nodes",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "properties",
        "first_seen",
        "last_seen",
        "origin_instance_id",
        "imported_from_instance_id",
        "derived_by_instance_id",
        "lineage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "properties": {
          "type": "object"
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "origin_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "imported_from_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "derived_by_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_id",
        "target_id",
        "confidence",
        "origin_instance_id",
        "imported_from_instance_id",
        "derived_by_instance_id",
        "lineage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "origin_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "imported_from_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "derived_by_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      }
    }
  }
}
