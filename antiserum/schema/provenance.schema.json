{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antiserum Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "vendor-advisory",
            "public-feed",
            "anthrosystems-intel",
            "dendrite-observation",
            "peer-dendrite-observation",
            "analyst-assertion",
            "ml-derived-intelligence"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "vendor-advisory",
                  "public-feed",
                  "anthrosystems-intel",
                  "analyst-assertion",
                  "ml-derived-intelligence"
                ]
              }
            }
          },
          "then": {
            "required": [
              "name",
              "reference",
              "retrieved_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "dendrite-observation",
                  "peer-dendrite-observation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "instance_id",
              "observed_at"
            ]
          }
        }
      ]
    }
  }
}
