{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antiserum Indicator Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "indicators": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/hash_indicator"
          },
          {
            "$ref": "#/$defs/domain_indicator"
          },
          {
            "$ref": "#/$defs/ip_indicator"
          },
          {
            "$ref": "#/$defs/url_indicator"
          }
        ]
      }
    }
  },
  "$defs": {
    "hash_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "algorithm",
        "value",
        "classification",
        "confidence",
        "first_seen",
        "last_seen",
        "tags",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^indicator:(?:sha256|sha512|sha1|md5):.+$"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "sha1",
            "md5"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "malicious",
            "suspicious",
            "benign",
            "unknown"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "md5"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{32}$"
              }
            }
          }
        }
      ]
    },
    "domain_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "classification",
        "confidence",
        "first_seen",
        "last_seen",
        "tags",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^indicator:domain:.+$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "malicious",
            "suspicious",
            "benign",
            "unknown"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "ip_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "version",
        "classification",
        "confidence",
        "first_seen",
        "last_seen",
        "tags",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^indicator:ip:.+$"
        },
        "value": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "enum": [
            4,
            6
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "malicious",
            "suspicious",
            "benign",
            "unknown"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "format": "ipv4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": {
                "const": 6
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "format": "ipv6"
              }
            }
          }
        }
      ]
    },
    "url_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "classification",
        "confidence",
        "first_seen",
        "last_seen",
        "tags",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^indicator:url:.+$"
        },
        "value": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "classification": {
          "type": "string",
          "enum": [
            "malicious",
            "suspicious",
            "benign",
            "unknown"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
