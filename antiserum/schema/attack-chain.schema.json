{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antiserum Attack Chains",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attack_chains"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "attack_chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attack_chain"
      }
    }
  },
  "$defs": {
    "lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "attack_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "confidence",
        "observed_at",
        "steps",
        "relationships",
        "supporting_evidence",
        "origin_instance_id",
        "imported_from_instance_id",
        "derived_by_instance_id",
        "lineage",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^chain:.+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "severity": {
          "type": "string",
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "object_id",
              "label",
              "kind"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "supporting_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "origin_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "imported_from_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "derived_by_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "original_title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "classification_confidence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "matched_vulnerability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "behaviour_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^behaviour:[A-Za-z0-9._:-]+$"
          }
        },
        "behaviour_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
